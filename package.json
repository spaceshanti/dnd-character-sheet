{
  "name": "dnd-sheet",
  "productName": "Character Sheet",
  "private": true,
  "version": "0.1.0",
  "description": "Desktop D&D character sheet",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "launch": "electron .",
    "dist": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "local.dnd.charsheet",
    "productName": "Character Sheet",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "@fontsource-variable/source-sans-3": "^5.1.0",
    "@fontsource/cinzel": "^5.1.0",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
