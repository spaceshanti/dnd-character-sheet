{
  "name": "dnd-sheet",
  "productName": "Character Sheet",
  "private": true,
  "version": "2.3.2",
  "description": "Desktop D&D character sheet",
  "author": "Santiago",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "app:dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "vite build && electron .",
    "launch": "electron .",
    "dist": "tsc --noEmit && vite build && electron-builder --win nsis",
    "dist:dir": "vite build && electron-builder --win dir"
  },
  "build": {
    "appId": "local.dnd.charsheet",
    "productName": "Character Sheet",
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      { "provider": "github", "owner": "spaceshanti", "repo": "dnd-character-sheet" }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Character Sheet",
      "artifactName": "Character-Sheet-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@fontsource-variable/exo-2": "^5.3.0",
    "@fontsource-variable/josefin-sans": "^5.3.0",
    "@fontsource-variable/jost": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.1.0",
    "@fontsource/cinzel": "^5.1.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "immer": "^10.1.1",
    "marked": "^12.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "zustand": "^4.5.5"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
